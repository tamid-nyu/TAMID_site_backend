{
  "name": "tamid-backend",
  "version": "1.0.0",
  "description": "Backend API for TAMID Group at NYU website with secure public endpoints",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:cloud:download": "tsx scripts/supabase-cloud.ts download",
    "supabase:cloud:apply": "tsx scripts/supabase-cloud.ts apply-local",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "test:ci": "npm test -- --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "express",
    "api",
    "tamid",
    "backend",
    "typescript"
  ],
  "author": "TAMID Group at NYU",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^1.5.10",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@supabase/supabase-js": "^2.39.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "pino": "^9.9.4",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.1",
    "resend": "^6.9.1",
    "swagger-jsdoc": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mailchimp__mailchimp_marketing": "^3.0.22",
    "@types/node": "^24.12.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "generate-env-example": "^1.1.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "supertest": "^7.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
