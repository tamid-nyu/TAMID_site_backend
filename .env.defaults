SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxEeeefJc2vejMZirUA0RA_9VKUs4RX
FRONTEND_URL=https://tamid-site.vercel.app
ADMIN_URL=https://tamid-site-internal.vercel.app
DISABLE_EMAIL_SENDING=true
DISABLE_MAILCHIMP_SYNC=true
SKIP_STARTUP_CONNECTION_TESTS=true
